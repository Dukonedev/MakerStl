{
  "name": "keygen-3d-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:3000 && tsc -p electron/tsconfig.json && electron .\"",
    "electron:build": "vite build && tsc -p electron/tsconfig.json && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.32.0",
    "@paypal/react-paypal-js": "^8.9.2",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.16",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.559.0",
    "mysql2": "^3.16.0",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.160.0",
    "three-bvh-csg": "^0.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.antigravity.keygen3d",
    "productName": "Keygen 3D",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    },
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  }
}