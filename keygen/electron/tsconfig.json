{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "../dist-electron",
        "module": "commonjs",
        "target": "es6",
        "lib": [
            "esnext"
        ],
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "noEmit": false,
        "moduleResolution": "node",
        "allowImportingTsExtensions": false
    },
    "include": [
        "main.cts"
    ]
}